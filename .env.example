# Šablona proměnných prostředí. Zkopírujte jako .env.local a doplňte skutečné
# hodnoty. .env.local se necommituje – obsahuje tajemství.

# Připojení k MySQL. Heslo musí být URL encoded (+ → %2B, @ → %40).
DATABASE_URL="mysql://user:password@host:3306/databaze"

# Náhodný řetězec, minimálně 32 znaků. Vygenerujte vlastní, např.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Veřejná adresa aplikace (lokálně http://localhost:3000).
APP_URL="http://localhost:3000"

# development | production
NODE_ENV="development"
